#!/usr/bin/env bash
# hexag CLI runner — delegates to cmd/hexag Go CLI.
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
HEXAG_ROOT="$(cd "$(dirname "$SOURCE")/.." && pwd)"

exec go run "$HEXAG_ROOT/cmd/hexag" "$@"
