{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "hexag hook claude session" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "hexag hook claude prompt" } ] }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [ { "type": "command", "command": "hexag hook claude edit", "timeout": 120 } ]
      }
    ]
  }
}
